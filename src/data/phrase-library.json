{
  "meta": {
    "name": "WSID phrase library",
    "version": "0.2.0",
    "changelog": "0.2.0 — simplified all phrasing to plain, everyday language (was too complex). Added NLP language-pattern layer via the optional `nlp` field and a glossary entry.",
    "primary_locale": "en",
    "locales": ["en", "ua"],
    "ua_note": "UA strings are native originals, not literal translations of EN. A pair shares meaning, not wording.",
    "register": { "ua": "ти, simple/everyday" },
    "readability_target": "short, plain words; easy to read at a glance",
    "stages_macro": {
      "thinking": ["priming"],
      "choice_given": ["reveal_question", "reveal_microline"],
      "by_emotion": ["reaction_positive", "reaction_negative", "closing"]
    },
    "emotions": {
      "positive": ["love_it", "feels_right"],
      "negative": ["doesnt_feel_right", "disappointed"]
    },
    "selection_rules": {
      "weighted_random": "Pick within a stage by `weight`. Higher weight = more likely.",
      "priority": "1 = core (default-eligible, includes shipped app copy), 2 = standard, 3 = occasional.",
      "no_repeat": "Do not show a phrase again within `conditions.no_repeat_within` sessions.",
      "emotion_gate": "For reaction_* stages, only show phrases whose conditions.emotion includes the user's selected emotion (null = any).",
      "show_if": "default = always eligible; first_session / returning_user = restrict by session count."
    },
    "mechanism_glossary": {
      "affect_labeling": { "claim": "Naming an emotion lowers distress.", "source": "Lieberman 2007; Torre & Lieberman 2018", "strength": "robust" },
      "affect_heuristic": { "claim": "People judge via a quick 'how do I feel about this?' signal.", "source": "Finucane/Slovic 2000; replicated 2022", "strength": "robust" },
      "feelings_as_information": { "claim": "A feeling is read as data about the choice — valid only if it's about THIS choice, not mood.", "source": "Schwarz & Clore 1983", "strength": "robust (with caveat)" },
      "anticipated_regret": { "claim": "Imagining an outcome surfaces preference; people are too change-averse.", "source": "Loomes & Sugden 1982; Levitt 2016", "strength": "robust" },
      "coin_catalyst": { "claim": "Reaction to a suggested option REFLECTS an existing preference.", "source": "Jaffe & Greifeneder 2021", "strength": "modest; does not prove a better decision" },
      "autonomy_support": { "claim": "Supportive, non-pressuring wording beats controlling wording.", "source": "Deci & Ryan; Ng 2012", "strength": "robust" },
      "self_affirmation": { "claim": "Affirming the self eases accepting a decision.", "source": "Steele 1988", "strength": "modest" },
      "imagined_outcome": { "claim": "Picturing an outcome as already real clarifies the feeling about it.", "source": "prospective hindsight / pre-mortem", "strength": "established technique" },
      "signal_not_certainty": { "claim": "Frame the result as a signal, never a verdict — guards against false certainty.", "source": "design principle (Jaffe H2 null; escalation literature)", "strength": "evidence-limit principle" },
      "nlp_language": { "claim": "Persuasion/rapport language patterns — presuppositions, embedded commands, sensory predicates, pacing-and-leading.", "source": "NLP practice (Bandler & Grinder)", "strength": "popular-practice; weak formal evidence — used here as a copy style, by curator's call", "note": "Tagged per-phrase in the optional `nlp` field." }
    },
    "field_guide": {
      "source_tag": "Primary mechanism this phrase leans on.",
      "nlp": "Optional. NLP language pattern in play: presupposition / embedded_command / sensory / pacing_leading / double_bind.",
      "why_note": "Working note for the curator. NOT shown in app. Edit freely.",
      "tone": "ritual = soft; plain = simple, easy to read.",
      "familiarity": "familiar = recognisable; novel = new but logical.",
      "len_band": "short / medium — UI fit hint."
    }
  },
  "phrases": [

    { "id": "priming_01", "stage": "priming", "from_app": true, "text": { "en": "Reach toward the one that brings a quiet smile.", "ua": "Потягнися до тієї, що дарує тиху усмішку." }, "source_tag": "affect_heuristic", "why_note": "Shipped copy. Asks for the gut signal, not reasons.", "tone": "ritual", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "priming_02", "stage": "priming", "text": { "en": "Imagine it's already done. Which one feels easier?", "ua": "Уяви, що це вже сталося. Що відчувається легше?" }, "source_tag": "imagined_outcome", "nlp": "presupposition", "why_note": "Presupposes it's done, then asks for the feeling.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "priming_03", "stage": "priming", "text": { "en": "Don't decide yet. Just notice which way you lean.", "ua": "Ще не вирішуй. Просто помічай, куди тягне." }, "source_tag": "affect_heuristic", "why_note": "Takes the pressure off; asks only for the lean.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "priming_04", "stage": "priming", "text": { "en": "Which one feels lighter?", "ua": "Що відчувається легше?" }, "source_tag": "affect_heuristic", "nlp": "sensory", "why_note": "Simplest possible felt-sense question.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_05", "stage": "priming", "text": { "en": "One already feels right. Let it show.", "ua": "Один уже відчувається правильним. Дай йому проявитись." }, "source_tag": "feelings_as_information", "nlp": "presupposition", "why_note": "Presupposes a preference already exists.", "tone": "plain", "familiarity": "novel", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "priming_06", "stage": "priming", "text": { "en": "Before the reasons — which one pulls you?", "ua": "Перед доводами — що тебе тягне?" }, "source_tag": "affect_heuristic", "why_note": "Catches the pre-rational pull.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_07", "stage": "priming", "text": { "en": "If it was already decided, which would you want it to be?", "ua": "Якби вже вирішилось — чого б ти хотів?" }, "source_tag": "coin_catalyst", "nlp": "presupposition", "why_note": "Coin-flip catalyst: hope reveals the lean.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "priming_08", "stage": "priming", "text": { "en": "Go with what you feel, not what you think.", "ua": "Іди за тим, що відчуваєш, а не що думаєш." }, "source_tag": "affect_heuristic", "nlp": "embedded_command", "why_note": "Simple, familiar instruction toward feeling.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_09", "stage": "priming", "text": { "en": "Which one makes you calmer?", "ua": "З чим тобі спокійніше?" }, "source_tag": "anticipated_regret", "nlp": "sensory", "why_note": "Calm as the felt tell.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_10", "stage": "priming", "text": { "en": "Stop weighing. Just feel.", "ua": "Годі зважувати. Просто відчуй." }, "source_tag": "affect_heuristic", "nlp": "embedded_command", "why_note": "Shifts from thinking to feeling in three words.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_11", "stage": "priming", "text": { "en": "Which one feels like a yes?", "ua": "Що відчувається як «так»?" }, "source_tag": "affect_heuristic", "why_note": "Frames the choice as a felt yes.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "priming_12", "stage": "priming", "text": { "en": "Picture each one. Which feels better?", "ua": "Уяви кожен варіант. Який кращий?" }, "source_tag": "imagined_outcome", "nlp": "sensory", "why_note": "Quick mental image to surface the feeling.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },

    { "id": "reveal_q_01", "stage": "reveal_question", "from_app": true, "text": { "en": "What did you feel first?", "ua": "Що ти відчув першим?" }, "source_tag": "affect_labeling", "why_note": "Shipped copy. Naming the feeling is the regulating act.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_02", "stage": "reveal_question", "text": { "en": "What did you feel before you started thinking?", "ua": "Що ти відчув ще до думок?" }, "source_tag": "affect_heuristic", "why_note": "Catches the pre-rational window.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "reveal_q_03", "stage": "reveal_question", "text": { "en": "What did your body say first?", "ua": "Що першим сказало тіло?" }, "source_tag": "affect_heuristic", "nlp": "sensory", "why_note": "Body-based, but simple and as a question.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_04", "stage": "reveal_question", "text": { "en": "Name what you felt.", "ua": "Назви, що відчув." }, "source_tag": "affect_labeling", "nlp": "embedded_command", "why_note": "Direct labeling instruction.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_05", "stage": "reveal_question", "text": { "en": "What came up first?", "ua": "Що з'явилось першим?" }, "source_tag": "affect_heuristic", "why_note": "Open, simple first-response question.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_06", "stage": "reveal_question", "text": { "en": "Quick — what did you feel?", "ua": "Швидко — що відчув?" }, "source_tag": "affect_heuristic", "why_note": "Speed stops over-thinking.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_07", "stage": "reveal_question", "text": { "en": "First feeling. Don't change it.", "ua": "Перше відчуття. Не змінюй його." }, "source_tag": "affect_labeling", "nlp": "embedded_command", "why_note": "Protects the raw signal from editing.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_08", "stage": "reveal_question", "text": { "en": "What did you feel when you saw it?", "ua": "Що ти відчув, коли побачив?" }, "source_tag": "affect_heuristic", "why_note": "Anchors to the moment of reveal.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_09", "stage": "reveal_question", "text": { "en": "Relief or resistance?", "ua": "Полегшення чи опір?" }, "source_tag": "anticipated_regret", "why_note": "Binary felt-sense check.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_10", "stage": "reveal_question", "text": { "en": "How did it feel?", "ua": "Як це відчулось?" }, "source_tag": "affect_labeling", "nlp": "sensory", "why_note": "The simplest open feeling question.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_11", "stage": "reveal_question", "text": { "en": "One word — what was it?", "ua": "Одне слово — яке?" }, "source_tag": "affect_labeling", "why_note": "Single word lowers the bar to name it.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "reveal_q_12", "stage": "reveal_question", "text": { "en": "What's under the thought?", "ua": "Що під думкою?" }, "source_tag": "affect_heuristic", "why_note": "Points beneath reasoning to the feeling.", "tone": "ritual", "familiarity": "novel", "priority": 3, "weight": 0.4, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },

    { "id": "reveal_micro_01", "stage": "reveal_microline", "from_app": true, "text": { "en": "Trust yourself.", "ua": "Довірся собі." }, "source_tag": "autonomy_support", "nlp": "embedded_command", "why_note": "Shipped copy. Keep it supportive, not pushy.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_02", "stage": "reveal_microline", "text": { "en": "Your answer is enough.", "ua": "Твоєї відповіді досить." }, "source_tag": "self_affirmation", "why_note": "No 'right' answer to reach.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_03", "stage": "reveal_microline", "text": { "en": "There's no wrong feeling.", "ua": "Хибних відчуттів не буває." }, "source_tag": "autonomy_support", "why_note": "Removes fear of answering wrong.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_04", "stage": "reveal_microline", "text": { "en": "It's already yours.", "ua": "Це вже твоє." }, "source_tag": "feelings_as_information", "why_note": "The feeling is something they own.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_05", "stage": "reveal_microline", "text": { "en": "You don't need a reason.", "ua": "Тобі не потрібна причина." }, "source_tag": "autonomy_support", "why_note": "Frees the feeling from justification.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_06", "stage": "reveal_microline", "text": { "en": "Whatever you felt, it matters.", "ua": "Що б ти не відчув — це важливо." }, "source_tag": "self_affirmation", "why_note": "Validates any response.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_07", "stage": "reveal_microline", "text": { "en": "This is a signal, not a test.", "ua": "Це сигнал, а не іспит." }, "source_tag": "signal_not_certainty", "why_note": "Reframes away from pass/fail.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_08", "stage": "reveal_microline", "text": { "en": "Stay with it a moment.", "ua": "Побудь із цим мить." }, "source_tag": "affect_labeling", "nlp": "embedded_command", "why_note": "Holding the feeling helps name it.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_09", "stage": "reveal_microline", "text": { "en": "You're allowed to know.", "ua": "Ти маєш право знати." }, "source_tag": "autonomy_support", "why_note": "Gentle permission, not a command.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_10", "stage": "reveal_microline", "text": { "en": "Only you feel this.", "ua": "Це відчуваєш тільки ти." }, "source_tag": "autonomy_support", "why_note": "The signal belongs to the user.", "tone": "plain", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_11", "stage": "reveal_microline", "text": { "en": "Let it be honest.", "ua": "Хай буде чесно." }, "source_tag": "affect_labeling", "why_note": "Invites the unedited feeling.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.5, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },
    { "id": "reveal_micro_12", "stage": "reveal_microline", "text": { "en": "Silence is an answer too.", "ua": "Тиша — теж відповідь." }, "source_tag": "self_affirmation", "why_note": "Normalises an unsure response.", "tone": "ritual", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 4 }, "len_band": "short" },

    { "id": "react_pos_01", "stage": "reaction_positive", "from_app": true, "text": { "en": "Your reaction helped reveal it.", "ua": "Твоя реакція допомогла це проявити." }, "source_tag": "coin_catalyst", "why_note": "Shipped copy. 'Revealed', not 'decided'.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_02", "stage": "reaction_positive", "text": { "en": "That lightness means something.", "ua": "Ця легкість щось означає." }, "source_tag": "feelings_as_information", "why_note": "Names ease as data.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_03", "stage": "reaction_positive", "text": { "en": "Part of you already wanted this.", "ua": "Частина тебе вже цього хотіла." }, "source_tag": "coin_catalyst", "nlp": "presupposition", "why_note": "Reaction mirrors a prior preference.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_04", "stage": "reaction_positive", "text": { "en": "You felt it before you thought it.", "ua": "Ти відчув це раніше, ніж подумав." }, "source_tag": "affect_heuristic", "why_note": "Affect comes before analysis.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_05", "stage": "reaction_positive", "text": { "en": "That yes came fast for a reason.", "ua": "Це «так» прийшло швидко не дарма." }, "source_tag": "affect_heuristic", "why_note": "A quick yes signals fit.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_06", "stage": "reaction_positive", "text": { "en": "Remember how that felt.", "ua": "Запам'ятай, як це відчувалось." }, "source_tag": "affect_labeling", "nlp": "embedded_command", "why_note": "Anchors the good feeling for later.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_07", "stage": "reaction_positive", "text": { "en": "Your first answer pointed here.", "ua": "Перша відповідь вказала сюди." }, "source_tag": "coin_catalyst", "why_note": "The first response found the preference.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_08", "stage": "reaction_positive", "text": { "en": "There was no resistance.", "ua": "Опору не було." }, "source_tag": "anticipated_regret", "why_note": "No resistance is itself the signal.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_09", "stage": "reaction_positive", "text": { "en": "You can trust this ease.", "ua": "Цій легкості можна довіряти." }, "source_tag": "autonomy_support", "nlp": "embedded_command", "why_note": "Encourages trust without ordering it.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_10", "stage": "reaction_positive", "text": { "en": "You recognised it, right?", "ua": "Ти ж упізнав це, так?" }, "source_tag": "coin_catalyst", "nlp": "presupposition", "why_note": "Recognition framing — leaves room to disagree.", "tone": "plain", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_11", "stage": "reaction_positive", "text": { "en": "That was your own voice.", "ua": "Це був твій власний голос." }, "source_tag": "self_affirmation", "why_note": "Affirms the inner signal.", "tone": "plain", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_pos_12", "stage": "reaction_positive", "text": { "en": "Let this calm stay.", "ua": "Хай цей спокій лишиться." }, "source_tag": "self_affirmation", "why_note": "Lets the good feeling settle.", "tone": "ritual", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": ["love_it", "feels_right"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },

    { "id": "react_neg_01", "stage": "reaction_negative", "text": { "en": "What pulled you to the other one?", "ua": "Що потягло тебе до іншого?" }, "source_tag": "anticipated_regret", "why_note": "Reflection question. Surfaces the real pull.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_02", "stage": "reaction_negative", "text": { "en": "Your reaction pointed elsewhere. Where?", "ua": "Реакція вказала інде. Куди?" }, "source_tag": "coin_catalyst", "why_note": "Echoes shipped 'pointed somewhere else'.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_03", "stage": "reaction_negative", "text": { "en": "What did this choice not give you?", "ua": "Чого цей вибір тобі не дав?" }, "source_tag": "affect_labeling", "why_note": "Names the lack.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_04", "stage": "reaction_negative", "text": { "en": "If it disappoints — what did you want instead?", "ua": "Якщо розчаровує — чого ти хотів натомість?" }, "source_tag": "anticipated_regret", "nlp": "presupposition", "why_note": "Surfaces the latent preference.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "medium" },
    { "id": "react_neg_05", "stage": "reaction_negative", "text": { "en": "What was missing?", "ua": "Чого бракувало?" }, "source_tag": "affect_heuristic", "why_note": "Simplest gap question.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_06", "stage": "reaction_negative", "text": { "en": "What part of you said no?", "ua": "Яка частина тебе сказала «ні»?" }, "source_tag": "affect_labeling", "why_note": "Locates the refusal.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_07", "stage": "reaction_negative", "text": { "en": "How would the other one have felt?", "ua": "Як відчувся б інший?" }, "source_tag": "imagined_outcome", "nlp": "sensory", "why_note": "Imagines the alternative to test the regret.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_08", "stage": "reaction_negative", "text": { "en": "What is the disappointment telling you?", "ua": "Що тобі каже це розчарування?" }, "source_tag": "feelings_as_information", "why_note": "Treats the letdown as a message.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.5, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_09", "stage": "reaction_negative", "text": { "en": "If you could switch — would you?", "ua": "Якби міг змінити — змінив би?" }, "source_tag": "anticipated_regret", "why_note": "The switch test — Levitt in miniature.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_10", "stage": "reaction_negative", "text": { "en": "What were you really hoping for?", "ua": "На що ти насправді сподівався?" }, "source_tag": "anticipated_regret", "why_note": "Names the hope behind the letdown.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_11", "stage": "reaction_negative", "text": { "en": "Where did your feeling go instead?", "ua": "Куди натомість пішло відчуття?" }, "source_tag": "affect_heuristic", "why_note": "Follows the redirected feeling.", "tone": "plain", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },
    { "id": "react_neg_12", "stage": "reaction_negative", "text": { "en": "What does this 'no' know?", "ua": "Що знає це «ні»?" }, "source_tag": "feelings_as_information", "why_note": "Treats the refusal as a knowing signal.", "tone": "ritual", "familiarity": "novel", "priority": 3, "weight": 0.4, "conditions": { "emotion": ["doesnt_feel_right", "disappointed"], "show_if": "default", "no_repeat_within": 5 }, "len_band": "short" },

    { "id": "closing_01", "stage": "closing", "from_app": true, "text": { "en": "This is not certainty. It's a signal worth listening to.", "ua": "Це не певність. Це сигнал, який варто почути." }, "source_tag": "signal_not_certainty", "why_note": "Shipped copy. The honesty anchor.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 1.0, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "medium" },
    { "id": "closing_02", "stage": "closing", "text": { "en": "This is what your reaction showed — not the answer.", "ua": "Це те, що показала реакція, — не відповідь." }, "source_tag": "signal_not_certainty", "why_note": "Guards against false certainty.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.9, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "medium" },
    { "id": "closing_03", "stage": "closing", "text": { "en": "Knowing how you feel is already a step.", "ua": "Знати, що відчуваєш, — це вже крок." }, "source_tag": "affect_labeling", "why_note": "Credits the labeling as progress.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_04", "stage": "closing", "text": { "en": "The choice is still yours.", "ua": "Вибір досі твій." }, "source_tag": "autonomy_support", "why_note": "Returns agency.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.8, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_05", "stage": "closing", "text": { "en": "A feeling is a clue, not a forecast.", "ua": "Відчуття — це підказка, не прогноз." }, "source_tag": "signal_not_certainty", "why_note": "Calibrates expectations honestly.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_06", "stage": "closing", "text": { "en": "Keep it, or let it go.", "ua": "Залиш це або відпусти." }, "source_tag": "autonomy_support", "nlp": "double_bind", "why_note": "Two open doors — fully non-directive.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_07", "stage": "closing", "text": { "en": "Most people are too afraid to change. Notice that.", "ua": "Більшість надто боїться змін. Поміть це." }, "source_tag": "anticipated_regret", "why_note": "Levitt's change-aversion finding, as a nudge.", "tone": "plain", "familiarity": "novel", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "medium" },
    { "id": "closing_08", "stage": "closing", "text": { "en": "Nothing is final. You just heard yourself.", "ua": "Нічого не остаточне. Ти просто почув себе." }, "source_tag": "signal_not_certainty", "why_note": "Reassures the choice stays open.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_09", "stage": "closing", "text": { "en": "Sleep on it before you decide.", "ua": "Переспи з цим, перш ніж вирішиш." }, "source_tag": "autonomy_support", "nlp": "embedded_command", "why_note": "Slows commitment — fights escalation.", "tone": "plain", "familiarity": "familiar", "priority": 2, "weight": 0.6, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_10", "stage": "closing", "text": { "en": "Your gut spoke. Your mind still has a turn.", "ua": "Чуття озвалось. У розуму ще буде черга." }, "source_tag": "signal_not_certainty", "why_note": "Balances intuition with deliberation.", "tone": "plain", "familiarity": "familiar", "priority": 1, "weight": 0.7, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "medium" },
    { "id": "closing_11", "stage": "closing", "text": { "en": "This was a mirror, not a map.", "ua": "Це було дзеркало, не карта." }, "source_tag": "signal_not_certainty", "why_note": "Crisp 'reflect, don't direct' line.", "tone": "ritual", "familiarity": "novel", "priority": 2, "weight": 0.5, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" },
    { "id": "closing_12", "stage": "closing", "text": { "en": "You met your own answer.", "ua": "Ти зустрів свою відповідь." }, "source_tag": "self_affirmation", "why_note": "Frames the moment as meeting the self.", "tone": "plain", "familiarity": "familiar", "priority": 3, "weight": 0.4, "conditions": { "emotion": null, "show_if": "default", "no_repeat_within": 6 }, "len_band": "short" }
  ]
}
